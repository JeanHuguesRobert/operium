# Public Guide: use a specific OpenRouter free model only after the normal
# synthesis providers have failed. This is non-secret; OPENROUTER_API_KEY
# remains in /srv/cogentia/secrets/guide.env.
#
# Rollback: remove this drop-in, then daemon-reload and restart mcp-cogentia.
[Service]
Environment=COGENTIA_GUIDE_OPENROUTER_FREE_FALLBACK=1
Environment=COGENTIA_GUIDE_OPENROUTER_FREE_MODEL=liquid/lfm-2.5-2.6b:free
Environment=COGENTIA_GUIDE_OPENROUTER_TIMEOUT_MS=25000
