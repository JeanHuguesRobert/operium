# Agent John WhatsApp — retrieval env (example, no secrets)
# Desired-state owner: operium/docs/agent-john-whatsapp-retrieval.md
# Code owner: cogentia scripts/lib/agent-jhn-whatsapp/draft.js

# guide | librarian | shadow  (default if unset: guide)
AGENT_JHN_WHATSAPP_RETRIEVAL=shadow

# Context Gateway (corpus librarian tools)
AGENT_JHN_WHATSAPP_GATEWAY_URL=http://127.0.0.1:8790

# Website Guide reuse for live guide/shadow answers
AGENT_JHN_WHATSAPP_GUIDE_URL=http://127.0.0.1:8791/guide/chat
AGENT_JHN_WHATSAPP_GUIDE_TIMEOUT_MS=45000

# Optional synthesis (load from vault / EnvironmentFile — never commit real keys)
# OPENAI_API_KEY=
# AGENT_JHN_WHATSAPP_OPENAI_MODEL=gpt-5.6-terra
# AGENT_JHN_WHATSAPP_OPENAI_FALLBACK_MODEL=gpt-4.1-mini
