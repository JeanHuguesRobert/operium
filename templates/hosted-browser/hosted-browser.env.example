# Per-session settings for hosted-browser@<unix-user>.service.
# Install as /etc/operium/hosted-browser/<unix-user>.env with root-owned 0640
# permissions. It contains no credential material.

# Unique X/KasmVNC display number for this workspace.
HOSTED_BROWSER_DISPLAY=2

# The remote browser's initial page. Use a mesh-reachable observer origin for a
# remote perspective; loopback is valid only when the observer is this host.
# Examples:
# HOSTED_BROWSER_START_URL=http://127.0.0.1:8794/
# HOSTED_BROWSER_START_URL=http://rpi3-view:8794/
HOSTED_BROWSER_START_URL=http://127.0.0.1:8794/

# Native TigerVNC-compatible RFB projection.  It is localhost-only on the
# server and must be reached through a trusted SSH tunnel.
# Classic x11vnc port. Must NOT equal 5900+display (KasmVNC native RFB).
HOSTED_BROWSER_RFB_PORT=5912
# HOSTED_BROWSER_RFB_LISTEN=127.0.0.1

# Session policy (issue #49). kiosk is the default. desktop requires
# future-idp, mesh bind, or a principal-lab waiver on public lab-sesame.
HOSTED_SESSION=kiosk
HOSTED_ASSURANCE=lab-sesame
HOSTED_BIND=public
HOSTED_ASSURANCE_WAIVER=none
HOSTED_CHROME_RESTART=on-exit
HOSTED_CHROME_COOLDOWN_SECONDS=5
# Stop relaunching after this many consecutive short/crash exits (not forever).
HOSTED_BROWSER_MAX_CRASH_STREAK=5
# Executable actually launched. On fracta2 this is Brave; Chromium is the
# fallback. Do not set Google Chrome on this architecture.
# HOSTED_BROWSER_BINARY=/usr/bin/brave-browser
# Unpacked MV3 extension loaded on every Brave start (navigation assistant).
# HOSTED_BROWSER_LOAD_EXTENSION=/home/hosted-user/src/cogentia/browser-extension

# The provisioner writes /home/<user>/.kasmpasswd with the lab sesame
# (Websockify user = Gmail local part, password sesame-<local-part>).
# Optional RFB still needs a private ~/.vnc/passwd if that unit is enabled.
