[Unit]
Description=Hosted Browser Session for %i (KasmVNC + Chromium + CDP)
After=network.target sound.target

[Service]
Type=simple
User=%i
Group=%i
Environment=HOME=/home/%i
Environment=XDG_CONFIG_HOME=/home/%i/.config
Environment=XDG_DATA_HOME=/home/%i/.local/share
EnvironmentFile=-/etc/operium/hosted-browser/%i.env
WorkingDirectory=/home/%i
ExecStart=/opt/operium/bin/start-hosted-browser.sh %i
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
