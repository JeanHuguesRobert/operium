<?xml version="1.0" encoding="UTF-8"?>
<!--
  Operium edge display for rpi3-view (~/.config/labwc/rc.xml).

  Fullscreen on open (like F11), but reversible — never Firefox --kiosk.
  - F11          : toggle fullscreen (leave / re-enter)
  - Super+Down   : minimize (restore panel / desktop access)
  - Super+Up     : maximize
  - Super        : usual labwc/RPi menu (if configured)
  - Alt+F4       : close window
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <libinput>
    <device category="default">
      <pointerSpeed>-0.400000</pointerSpeed>
    </device>
  </libinput>
  <keyboard>
    <repeatRate>25</repeatRate>
    <repeatDelay>500</repeatDelay>
    <keybind key="F11">
      <action name="ToggleFullscreen"/>
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify"/>
    </keybind>
    <keybind key="W-Up">
      <action name="Maximize"/>
    </keybind>
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
  </keyboard>
  <theme>
    <name>PiXflat</name>
    <font place="ActiveWindow">
      <name>PibotoLt</name>
      <size>12</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>PibotoLt</name>
      <size>12</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
  </theme>
  <windowRules>
    <!-- app_id / WM_CLASS variants for Firefox ESR -->
    <windowRule identifier="firefox*" matchOnce="true">
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="Firefox*" matchOnce="true">
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="org.mozilla.firefox*" matchOnce="true">
      <action name="ToggleFullscreen"/>
    </windowRule>
  </windowRules>
</openbox_config>
