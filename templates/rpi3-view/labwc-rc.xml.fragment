<?xml version="1.0" encoding="UTF-8"?>
<!--
  Operium edge display: merge into ~/.config/labwc/rc.xml on rpi3-view
  (or replace if the file only holds pointer speed + theme).
  Fullscreen Firefox for the home portal (same idea as F11).
  Exit: F11 or Esc (browser), Super for labwc / panel, Alt+F4 closes window.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <libinput>
    <device category="default">
      <pointerSpeed>-0.400000</pointerSpeed>
    </device>
  </libinput>
  <keyboard>
    <repeatRate>25</repeatRate>
    <repeatDelay>500</repeatDelay>
    <!-- F11-like if Firefox is focused but not already kiosk -->
    <keybind key="F11">
      <action name="ToggleFullscreen"/>
    </keybind>
  </keyboard>
  <theme>
    <name>PiXflat</name>
    <font place="ActiveWindow">
      <name>PibotoLt</name>
      <size>12</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>PibotoLt</name>
      <size>12</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
  </theme>
  <windowRules>
    <!-- Wayland app_id / XWayland WM_CLASS variants for Firefox ESR -->
    <windowRule identifier="firefox*" matchOnce="true">
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="Firefox*" matchOnce="true">
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="org.mozilla.firefox*" matchOnce="true">
      <action name="ToggleFullscreen"/>
    </windowRule>
  </windowRules>
</openbox_config>

