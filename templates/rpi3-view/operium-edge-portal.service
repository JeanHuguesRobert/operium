[Unit]
Description=Operium edge consultation portal
After=network.target

[Service]
Type=simple
User=jh
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/bin/busybox httpd -f -p 80 -h /srv/operium-edge-portal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
