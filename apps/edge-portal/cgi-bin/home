#!/bin/sh
# Server-rendered home for light browsers (optional). Valid HTML5, no JS required.
set -eu
PORTAL_DIR="${OPERIUM_EDGE_PORTAL_DIR:-/srv/operium-edge-portal}"
STATUS="$PORTAL_DIR/status.json"
GENERATED="unknown"
VS="unknown"
FR="unknown"
WS="unknown"
PH="unknown"

flag() {
  case "$1" in
    true) printf 'OK' ;;
    false) printf 'down' ;;
    *) printf '?' ;;
  esac
}

if [ -f "$STATUS" ]; then
  GENERATED="$(grep -o '"generated_at"[[:space:]]*:[[:space:]]*"[^"]*"' "$STATUS" | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
  VS="$(grep -o '"views_store"[[:space:]]*:[[:space:]]*[a-z]*' "$STATUS" | head -1 | awk -F: '{gsub(/[[:space:]]/,"",$2); print $2}')"
  FR="$(grep -o '"fracta"[[:space:]]*:[[:space:]]*[a-z]*' "$STATUS" | head -1 | awk -F: '{gsub(/[[:space:]]/,"",$2); print $2}')"
  WS="$(grep -o '"workstation"[[:space:]]*:[[:space:]]*[a-z]*' "$STATUS" | head -1 | awk -F: '{gsub(/[[:space:]]/,"",$2); print $2}')"
  PH="$(grep -o '"phone"[[:space:]]*:[[:space:]]*[a-z]*' "$STATUS" | head -1 | awk -F: '{gsub(/[[:space:]]/,"",$2); print $2}')"
fi

printf 'Content-Type: text/html; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n'
printf '\r\n'
cat <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="60">
  <title>Fractanet Edge Portal</title>
  <style type="text/css">
    body { font-family: sans-serif; margin-top: 1.2rem; margin-right: 1.2rem; margin-bottom: 1.2rem; margin-left: 1.2rem; background-color: #0b1118; color: #e8eef5; }
    h1 { color: #73b7ff; }
    a { color: #73b7ff; }
    .card { border: 1px solid #26384a; padding-top: 0.8rem; padding-right: 1rem; padding-bottom: 0.8rem; padding-left: 1rem; margin-top: 0.8rem; margin-bottom: 0.8rem; background-color: #121c27; }
    .muted { color: #91a4b7; font-size: 0.9rem; }
    table { border-collapse: collapse; width: 100%; }
    td { padding-top: 0.35rem; padding-right: 0.5rem; padding-bottom: 0.35rem; padding-left: 0.5rem; border-bottom: 1px solid #26384a; }
  </style>
</head>
<body>
  <h1>Fractanet Edge Portal</h1>
  <p class="muted">Local home on this Pi · auto-refresh 60s · no JavaScript required</p>
  <div class="card">
    <h2>Network status</h2>
    <table>
      <tr><td>Views Store</td><td>$(flag "$VS")</td></tr>
      <tr><td>Fracta</td><td>$(flag "$FR")</td></tr>
      <tr><td>Workstation</td><td>$(flag "$WS")</td></tr>
      <tr><td>Phone</td><td>$(flag "$PH")</td></tr>
      <tr><td>This Pi</td><td>OK</td></tr>
    </table>
    <p class="muted">Snapshot: ${GENERATED:-unknown}</p>
    <p><a href="/cgi-bin/refresh">Re-probe now</a> (JSON) ·
       <a href="/cgi-bin/home">Reload this page</a></p>
  </div>
  <div class="card">
    <h2>Links</h2>
    <p><a href="https://cogentia.fractavolta.com/">Cogentia Views Store</a></p>
    <p><a href="https://cogentia.fractavolta.com/docs">Views Store documentation</a></p>
    <p><a href="/status.json">status.json</a> ·
       <a href="/cgi-bin/fleet">fleet JSON</a> ·
       <a href="/cgi-bin/refresh">Re-probe</a></p>
    <p><a href="http://127.0.0.1:8794/.well-known/soma">Local SOMA</a> ·
       <a href="http://127.0.0.1:8794/node/status">Local ONA status</a></p>
    <p><a href="/">La Nasa (fleet UI)</a> ·
       <a href="/simple.html">Simple home</a></p>
  </div>
</body>
</html>
EOF
