#!/bin/sh
# Aggregate ONA /node/status for Fractanet embryo (same-origin for La Nasa UI).
# Uses MagicDNS first, then Tailscale IPv4, then loopback for self.
set -eu

OUT=$(mktemp)
trap 'rm -f "$OUT"' EXIT

gen_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

resolve_base() {
  host="$1"
  if [ "$host" = "rpi3-view" ]; then
    printf 'http://127.0.0.1:8794'
    return 0
  fi
  # Try short name
  if curl -fsS --max-time 2 "http://${host}:8794/health" >/dev/null 2>&1; then
    printf 'http://%s:8794' "$host"
    return 0
  fi
  # Tailscale IP
  if command -v tailscale >/dev/null 2>&1; then
    tip=$(tailscale ip -4 "$host" 2>/dev/null || true)
    if [ -n "$tip" ]; then
      if curl -fsS --max-time 2 "http://${tip}:8794/health" >/dev/null 2>&1; then
        printf 'http://%s:8794' "$tip"
        return 0
      fi
    fi
  fi
  # Last try: short name for status even if /health failed
  printf 'http://%s:8794' "$host"
}

probe_one() {
  host="$1"
  rid="$2"
  label="$3"
  base=$(resolve_base "$host")
  url="${base}/node/status"
  body=""
  code=0
  if body=$(curl -fsS --max-time 5 "$url" 2>/dev/null); then
    code=200
  fi

  online=false
  health=null
  hostname=null
  if [ "$code" -eq 200 ] && [ -n "$body" ]; then
    online=true
    hs=$(printf '%s\n' "$body" | grep -o '"health_score"[[:space:]]*:[[:space:]]*[0-9][0-9.]*' | head -1 | sed 's/.*:[[:space:]]*//')
    [ -n "${hs:-}" ] && health=$hs
    hn=$(printf '%s\n' "$body" | grep -o '"hostname"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    if [ -n "${hn:-}" ]; then
      hostname=$(printf '"%s"' "$hn")
    fi
  fi

  printf '{"host":"%s","resource_id":"%s","label":"%s","online":%s,"http_status":%s,"health_score":%s,"hostname":%s,"endpoint":"%s","base":"%s"}\n' \
    "$host" "$rid" "$label" "$online" "$code" "$health" "${hostname:-null}" "$url" "$base" >>"$OUT"
}

probe_one "fracta" "resource://fracta" "Fracta"
probe_one "i7-thinkpad-jhr" "resource://i7-thinkpad-jhr" "Workstation"
probe_one "rpi3-view" "resource://rpi3-view" "This Pi"
probe_one "poco-jhr" "resource://poco-jhr" "Phone"

printf 'Content-Type: application/json; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n'
printf '\r\n'
printf '{\n  "schema": "operium.edge-portal.fleet.v1",\n'
printf '  "generated_at": "%s",\n' "$gen_at"
printf '  "mode": "mesh-pull",\n'
printf '  "nodes": [\n'
awk 'NR>1{print prev","} {prev=$0} END{if(NR) print prev}' "$OUT" | sed 's/^/    /'
printf '\n  ]\n}\n'
