{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cop/node.close.v1",
  "title": "COP node close Event — stop a calendar wake obligation",
  "type": "object",
  "required": ["id", "packet_type", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "packet_type": { "const": "cop/node.close.v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["schema", "obligation_id"],
      "properties": {
        "schema": { "const": "cop/node.close.v1" },
        "obligation_id": { "type": "string", "minLength": 1 },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
