[Unit]
Description=FractaFunction JHN Deno worker (loopback, allow-listed external weather source)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/cogentia/repos/operium
Environment=FRACTAFUNCTION_DENO_PORT=8797
ExecStart=/usr/local/node-v26.5.0/bin/node /srv/cogentia/repos/operium/runtimes/serverless/bootstrap-jhn-deno.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=fractafunction-jhn-deno
Environment=DENO_DIR=/run/fractafunction-jhn-deno
ReadWritePaths=/run/fractafunction-jhn-deno
UMask=0077

[Install]
WantedBy=multi-user.target
